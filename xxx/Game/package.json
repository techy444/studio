{
  "name": "codeduel-arena",
  "version": "1.0.0",
  "description": "CodeDuel Arena - Full Stack Application",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && /root/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --reload",
    "frontend": "cd frontend && yarn dev",
    "install-all": "cd backend && pip install -r requirements.txt && cd ../frontend && yarn install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
